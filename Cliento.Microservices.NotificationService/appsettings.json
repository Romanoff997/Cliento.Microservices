{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [ { "Name": "Console" } ],
    "Properties": { "Application": "NotificationService" }
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "rabbit",
    "Password": "rabbitpass",
    "Exchange": "crm.events",
    "Queue": "crm.events.queue",
    "RoutingKey": "#"
  }
}